# ============================================================
# BACKEND LOCAL DEVELOPMENT (.env)
# ============================================================
# Copy to BackEnd/.env and adjust values for your machine.
# DO NOT commit BackEnd/.env (gitignored).
# Run backend from BackEnd/: ./mvnw spring-boot:run
# ============================================================

# Server Configuration
spring.profiles.active=dev
server.port=8080
server.servlet.context-path=/

# MySQL Database
spring.datasource.url=jdbc:mysql://localhost:3306/english_learning?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=

# JPA/Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Security (JWT) — generate a new 256-bit hex key for production
application.security.jwt.secret-key=<GENERATE_256BIT_HEX_KEY>
application.security.jwt.expiration=86400000
application.security.jwt.refresh-token.expiration=604800000

# CORS
application.cors.allowed-origins=http://localhost:3000,http://localhost:3001

# Dev-only security (false in production)
application.security.swagger.enabled=true
application.security.seed-login.enabled=true
spring.data.redis.enabled=true
rate-limit.trust-proxy-headers=false

# Mail (SMTP Gmail - OTP)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<YOUR_GMAIL>
spring.mail.password=<GMAIL_APP_PASSWORD>
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.default-encoding=UTF-8

# ============================================================
# PRODUCTION (Railway / Render) — set in dashboard, not .env
# ============================================================
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/railway?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
# APPLICATION_SECURITY_JWT_SECRET_KEY=<GENERATE_NEW_256BIT_HEX_KEY>
# APPLICATION_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# SPRING_DATA_REDIS_HOST=<UPSTASH_HOST>
# SPRING_DATA_REDIS_PASSWORD=<UPSTASH_TOKEN>
# SPRING_MAIL_USERNAME=<YOUR_GMAIL>
# SPRING_MAIL_PASSWORD=<GMAIL_APP_PASSWORD>
